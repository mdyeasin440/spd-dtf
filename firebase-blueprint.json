{
  "entities": {
    "DesignPreset": {
      "title": "Design Preset Specification",
      "description": "Design specification containing font styles, colors, letter PNG assets, and number PNG assets for DTF printing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "teamName": { "type": "string" },
        "league": { "type": "string" },
        "season": { "type": "string" },
        "fontFamily": { "type": "string" },
        "customFontDataUrl": { "type": "string" },
        "textColor": { "type": "string" },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number" },
        "textEffect": { "type": "string" },
        "arcAmount": { "type": "number" },
        "letterSpacing": { "type": "number" },
        "defaultNameWidthInches": { "type": "number" },
        "defaultNameHeightInches": { "type": "number" },
        "defaultNumberHeightInches": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "teamName", "league", "fontFamily"]
    }
  },
  "firestore": {
    "/designs/{designId}": {
      "schema": "DesignPreset",
      "description": "Saved designs with typography details, colors, asset references, and specs"
    },
    "/design_presets/{presetId}": {
      "schema": "DesignPreset",
      "description": "Global design presets with uploaded PNG assets"
    }
  }
}
